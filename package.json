{
  "name": "cbsr-mapper",
  "private": true,
  "version": "0.11.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check-invariants.mjs && npm run check:snapshot",
    "check:snapshot": "python3 tools/build_mapper_snapshot.py --register ../cross-border-stablecoin-register --out src/data.snapshot.js --check",
    "build": "npm run check && vite build && node scripts/check-invariants.mjs --dist",
    "preview": "vite preview",
    "build:offline": "node scripts/build-offline.mjs . dist-offline/mapper.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "typescript": "^5.6.0"
  }
}
